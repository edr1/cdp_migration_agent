# ---------------------------------------------------------------
# Copia este archivo a .env y ajusta valores:  cp .env.example .env
# ---------------------------------------------------------------

# Red docker compartida entre origen (Cloudera) y destino (Trino)
CDP_NETWORK=cdp-migration-net

# ---------- ORIGEN: Cloudera (Hive + Hive Metastore [+ Impala]) ----------
HIVE_VERSION=4.0.1
HMS_DB_USER=hive
HMS_DB_PASSWORD=hive_password
HMS_DB_NAME=metastore_db
HIVESERVER2_PORT=10000
HIVESERVER2_UI_PORT=10002
HIVE_METASTORE_PORT=9083

# Impala (perfil opcional "impala"; solo imagenes linux/amd64)
IMPALA_VERSION=4.4.1
IMPALA_HS2_PORT=21050
IMPALA_UI_PORT=25000

# ---------- DESTINO: Trino + Iceberg (MinIO + catalogo JDBC Postgres) ----------
TRINO_VERSION=476
TRINO_PORT=8080
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ICEBERG_BUCKET=warehouse
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=iceberg_password
ICEBERG_DB_NAME=iceberg_catalog
