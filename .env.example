# ---------------------------------------------------------------
# Copia este archivo a .env y ajusta valores:  cp .env.example .env
# ---------------------------------------------------------------

# Red docker compartida entre origen (Cloudera) y destino (Trino)
CDP_NETWORK=cdp-migration-net

# ---------- ORIGEN: Cloudera (Hive + Hive Metastore [+ Impala]) ----------
HIVE_VERSION=4.0.1
HMS_DB_USER=hive
HMS_DB_PASSWORD=hive_password
HMS_DB_NAME=metastore_db
HIVESERVER2_PORT=10000
HIVESERVER2_UI_PORT=10002
HIVE_METASTORE_PORT=9083

# Impala (perfil opcional "impala"; solo imagenes linux/amd64)
IMPALA_VERSION=4.4.1
IMPALA_HS2_PORT=21050
IMPALA_UI_PORT=25000

# Hue (perfil opcional "hue")
HUE_VERSION=4.11.0
HUE_PORT=8888

# ---------- DESTINO: Trino + Iceberg (SeaweedFS S3 + catalogo JDBC Postgres) ----------
TRINO_VERSION=476
TRINO_PORT=8080
# SeaweedFS: almacenamiento compatible S3 (reemplaza a MinIO)
SEAWEEDFS_VERSION=3.80
AWS_CLI_VERSION=2.15.0
S3_ACCESS_KEY=cdp_access_key
S3_SECRET_KEY=cdp_secret_key_change_me
S3_API_PORT=8333
S3_MASTER_UI_PORT=9333
ICEBERG_BUCKET=warehouse
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=iceberg_password
ICEBERG_DB_NAME=iceberg_catalog

# ---------- LLM del motor agentico ----------
# Ollama remoto en la DGX Spark con Nemotron 3.5 Lightning 30B-A3B.
# En la DGX:  OLLAMA_HOST=0.0.0.0:11434 ollama serve   y   ollama pull nemotron-3.5-lightning:30b-a3b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434   # o http://<ip-dgx>:11434 si el agente corre en otra maquina
LLM_MODEL=nemotron-3.5-lightning:30b-a3b         # en DGX Spark tambien: nemotron-3.5-lightning:30b-a3b-nvfp4
LLM_NUM_CTX=32768
LLM_THINK=false
# Alternativa NVIDIA NIM (API OpenAI):  LLM_PROVIDER=openai  LLM_BASE_URL=http://nim:8000/v1  + make nim-up
